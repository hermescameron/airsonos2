[Unit]
Description=AirSonos2 AirPlay bridge for Sonos
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=airsonos2
Group=airsonos2
StateDirectory=airsonos2
ConfigurationDirectory=airsonos2
ExecStart=/usr/local/bin/airsonos2 serve --config /etc/airsonos2/config.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
